<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ylb.mapper.TbDormManagerMapper">

    <!-- 新增宿管档案 -->
    <insert id="insert" parameterType="com.ylb.entity.TbDormManager">
        INSERT INTO tb_dorm_manager
        (
            manager_id,
            work_no,
            name,
            phone
        )
        VALUES
            (
                #{managerId},
                #{workNo},
                #{name},
                #{phone}
            )
    </insert>

</mapper>

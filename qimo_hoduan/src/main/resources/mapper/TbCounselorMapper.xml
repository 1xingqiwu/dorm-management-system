<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ylb.mapper.TbCounselorMapper">

    <!-- 新增辅导员档案 -->
    <insert id="insert" parameterType="com.ylb.entity.TbCounselor">
        INSERT INTO tb_counselor
        (
            counselor_id,
            work_no,
            name,
            phone,
            create_time
        )
        VALUES
            (
                #{counselorId},
                #{workNo},
                #{name},
                #{phone},
                NOW()
            )
    </insert>

</mapper>

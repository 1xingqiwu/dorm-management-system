<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ylb.mapper.TbRepairMapper">
    <resultMap id="BaseResultMap" type="com.ylb.entity.TbRepair">
        <id column="repair_id" property="repairId" />
        <result column="student_id" property="studentId" />
        <result column="building_id" property="buildingId" />
        <result column="room_id" property="roomId" />
        <result column="repair_type" property="repairType" />
        <result column="description" property="description" />
        <result column="image_urls" property="imageUrls" />
        <result column="status" property="status" />
        <result column="submit_time" property="submitTime" />
        <result column="finish_time" property="finishTime" />
    </resultMap>

    <insert id="insert">
        INSERT INTO tb_repair
        (student_id, building_id, room_id, repair_type, description, image_urls, status, submit_time)
        VALUES
            (#{studentId}, #{buildingId}, #{roomId}, #{repairType}, #{description}, #{imageUrls}, 0, NOW())
    </insert>

    <!-- 查询我的报修 -->
    <select id="selectListByStudent" resultMap="BaseResultMap">
        SELECT * FROM tb_repair WHERE student_id = #{studentId} ORDER BY submit_time DESC
    </select>

    <!-- 查询所有报修单 (支持按状态筛选) -->
    <select id="selectListAll" resultMap="BaseResultMap">
        SELECT * FROM tb_repair
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY submit_time DESC
    </select>

    <!-- 更新处理结果 -->
    <update id="updateStatus">
        UPDATE tb_repair
        SET
            status = #{status},
            finish_time = NOW()
        WHERE repair_id = #{repairId}
    </update>
</mapper>